{
  "name": "creator-metrics-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Daily YouTube and Pinterest metrics collector for Google Sheets",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "collect": "tsx src/cli.ts collect",
    "collect:youtube": "tsx src/cli.ts collect:youtube",
    "collect:pinterest": "tsx src/cli.ts collect:pinterest",
    "collect:threads": "tsx src/cli.ts collect:threads",
    "diagnose:youtube": "tsx src/cli.ts diagnose:youtube",
    "diagnose:threads": "tsx src/cli.ts diagnose:threads",
    "auth:google": "tsx src/cli.ts auth:google",
    "auth:threads": "tsx src/cli.ts auth:threads",
    "import:csv": "tsx src/cli.ts import:csv",
    "import:note": "tsx src/cli.ts import:note",
    "import:rakuten": "tsx src/cli.ts import:rakuten",
    "dashboard": "tsx src/cli.ts dashboard",
    "report": "tsx src/cli.ts report",
    "daily": "tsx src/cli.ts daily",
    "scheduler:install": "node scripts/scheduler.mjs install",
    "scheduler:status": "node scripts/scheduler.mjs status",
    "scheduler:run": "node scripts/scheduler.mjs run",
    "scheduler:uninstall": "node scripts/scheduler.mjs uninstall",
    "post:threads:add": "tsx src/cli.ts post:threads:add",
    "post:threads:list": "tsx src/cli.ts post:threads:list",
    "post:threads:review": "tsx src/cli.ts post:threads:review",
    "post:threads:approve": "tsx src/cli.ts post:threads:approve",
    "post:threads:schedule": "tsx src/cli.ts post:threads:schedule",
    "post:threads:cancel": "tsx src/cli.ts post:threads:cancel",
    "post:threads:dry-run": "tsx src/cli.ts post:threads:dry-run",
    "post:threads:publish": "tsx src/cli.ts post:threads:publish",
    "post:threads:due": "tsx src/cli.ts post:threads:due",
    "post:threads:import": "tsx src/cli.ts post:threads:import",
    "post:threads:approve-all": "tsx src/cli.ts post:threads:approve-all",
    "post:threads:schedule-imported": "tsx src/cli.ts post:threads:schedule-imported",
    "post:threads:schedule-batch": "tsx src/cli.ts post:threads:schedule-batch",
    "post:threads:status": "tsx src/cli.ts post:threads:status",
    "post:threads:upcoming": "tsx src/cli.ts post:threads:upcoming",
    "post:scheduler:install": "node scripts/post-scheduler.mjs install",
    "post:scheduler:status": "node scripts/post-scheduler.mjs status",
    "post:scheduler:run": "node scripts/post-scheduler.mjs run",
    "post:scheduler:uninstall": "node scripts/post-scheduler.mjs uninstall",
    "test": "vitest run",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^176.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

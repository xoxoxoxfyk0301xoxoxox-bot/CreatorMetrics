# Runtime (all dates are interpreted in this timezone)
TZ=Asia/Tokyo
# Optional. Defaults to yesterday in Asia/Tokyo.
# COLLECTION_DATE=2026-08-25

# Google OAuth 2.0 Desktop/Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Generate with: npm run auth:google
GOOGLE_REFRESH_TOKEN=
METRICS_SPREADSHEET_ID=
GOOGLE_METRICS_SHEET=DailyMetrics
GOOGLE_CONTENT_SHEET=ContentMetrics
GOOGLE_LOG_SHEET=CollectionLog

# YouTube: the OAuth user must own or have access to this channel.
# Use "mine" to resolve the authenticated user's channel.
YOUTUBE_CHANNEL_ID=mine

# Pinterest API v5 OAuth access token and account username.
# Pinterest tokens are managed in the Pinterest developer portal/OAuth flow.
PINTEREST_ACCESS_TOKEN=
PINTEREST_USERNAME=
PINTEREST_BASE_URL=https://api.pinterest.com/v5

# Threads API (read-only: threads_basic, threads_manage_insights)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-public-callback.example.com/oauth2callback
THREADS_CALLBACK_HOST=127.0.0.1
THREADS_CALLBACK_PORT=3100
THREADS_ACCESS_TOKEN=
THREADS_LOOKBACK_DAYS=90
THREADS_TOKEN_FILE=.threads-token.json
THREADS_BASE_URL=https://graph.threads.net
